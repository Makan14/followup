# Environnement par défaut. Les vraies valeurs locales vont dans .env.local.
APP_ENV=dev
APP_SECRET=dev_followup_change_me_not_a_real_secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# Valeur par défaut pensée pour XAMPP MariaDB.
# Adaptez utilisateur/mot de passe/version dans .env.local si besoin.
DATABASE_URL="mysql://root:@127.0.0.1:3306/followup?serverVersion=mariadb-10.4.32&charset=utf8mb4"
