# Copiez ce fichier vers .env.local puis adaptez les valeurs.
APP_ENV=dev
APP_SECRET=changez_moi_avec_une_longue_valeur_aleatoire

# XAMPP par défaut : utilisateur root, mot de passe vide.
DATABASE_URL="mysql://root:@127.0.0.1:3306/followup?serverVersion=mariadb-10.4.32&charset=utf8mb4"

# Exemple MySQL 8 :
# DATABASE_URL="mysql://followup:_mot_de_passe@127.0.0.1:3306/followup?serverVersion=8.0.32&charset=utf8mb4"

# Exemple MariaDB 11 :
# DATABASE_URL="mysql://followup:_mot_de_passe@127.0.0.1:3306/followup?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
