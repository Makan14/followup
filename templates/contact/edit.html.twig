{% extends 'base.html.twig' %}

{% block title %}Modifier {{ contact.nom }} — FollowUp{% endblock %}

{% block topbar_title %}<span class="app-topbar__title">Modifier un contact</span>{% endblock %}

{% block body %}
<div class="fu-page fu-page--narrow">
    <header class="fu-heading">
        <div>
            <p class="fu-heading__eyebrow">Contacts</p>
            <h1 class="fu-heading__title">Modifier le contact</h1>
            <p class="fu-heading__sub">{{ contact.nom }}{% if contact.entreprise %} — {{ contact.entreprise }}{% endif %}</p>
        </div>
        <div class="fu-heading__actions">
            <a class="fu-btn fu-btn--ghost" href="{{ path('app_contact_show', {id: contact.id}) }}">Voir la fiche</a>
        </div>
    </header>

    <div class="fu-panel">
        {% include 'contact/_form.html.twig' %}
    </div>
</div>
{% endblock %}
